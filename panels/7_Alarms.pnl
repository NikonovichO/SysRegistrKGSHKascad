E "main(int button)
{
  filter_Status = this.number();//получает выбранный вариант 0 - список текущих сообщений, 1 - архив.
  bool permission; //разрешение на ввод значений

  if (filter_Status == 0) //список - отключает фильтр по временному промежутку
  {
    permission = false;
  }
  else if (filter_Status == 1) //архив - включает фильтр по временному промежутку
  {
    permission = true;
  }

  DE_START.enabled = permission;
  DE_END.enabled = permission;
  btnDay.enabled = permission;
  btnWeek.enabled = permission;

  p_result = queryMessages(query); //запрос
  loadMessages(p_result);         //загрузка
}" 0

