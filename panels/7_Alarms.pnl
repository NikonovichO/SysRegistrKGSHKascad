E "// ===========================     КОНСТАНТЫ     ===========================
const string base_query = \"SELECT ALERT \"+
                             \"'_alert_hdl.._ack_state',\" +    //3
                             \"'_alert_hdl.._abbr',\" +         //4
                             \"'_alert_hdl.._text',\" +         //5
                             \"'_alert_hdl.._direction',\" +    //6
                             \"'_alert_hdl.._ack_time',\" +     //7
                             \"'_alert_hdl.._ack_user',\" +     //8
                             \"'_alert_hdl.._alert_color',\";   //9

const string archive_query = \"'_alert_hdl.._class,'\" +        // 10 для получения цветов прямо из класса аларма
                             \"'_alert_class.._prior'\" +       // 11 для получения цветов из общего массива цветов по приоритету
                             \" FROM '*'\"+
                             \" WHERE '_alert_hdl.._prior' > 25\";

const string active_query = \"'_alert_hdl.._alert_fore_color',\" + // 10 просто получаем текущий цвет текста
                            \"'_alert_hdl.._act_state'\"+          // 11 просто получаем текущий цвет фона
                            \" FROM '*'\"+
                            \" WHERE '_alert_hdl.._prior' > 25\";

const string queryDTformat = \"%Y.%m.%d %H:%M:%S\"; // Формат даты/времени для запроса

const int DP = 1,
          msgTime = 2,
          ackState = 3,
          msgAbr = 4,
          msgText = 5,
          direction = 6,
          ackTime = 7,
          user = 8,
          backColor = 9,
          foreColor = 10,
          msgClassName = 10,
          msgPrior = 11,
          actState = 11;


// ===========================     ГЛОБ.ПЕРЕМЕННЫЕ     ===========================

//  фильтры
dyn_string filter_Type;        //тип сообщения
int filter_Status;            // 0-активные, 1-ушедшие
int filter_Line;             //линия
int filter_Press;           //пресс
string timeFrom, timeTo;   //временные рамки

mapping placeDeviceFilter; // Фильтр по месту/устройству

//  другие
string query;
dyn_dyn_anytype p_result; // Массив с результатами запроса
dyn_dyn_string ColorClasses_array; //массив с цветами сообщений

/* ===========================    ФУНКЦИИ ПОДГОТОВКИ К ЗАГРУЗКЕ     =========================== */

//  Начальные параметры

void preloadClear(){ //запускается при init панели алармов
  AlarmTable.deleteAllLines();
}

// очистить ТИП

void filterTypeClear(){
  filter_Type = makeDynString();
  int n = Type_CB.itemCount();
  for (int i = 0; i < n; i++)
  {
    Type_CB.state(i, FALSE);
  }
}

// очистить фильтр по линии и прессу

void filterPlaceClear(){
  Line_CB.currentIndex(0);
  Press_CB.currentIndex(0);
  int filter_Line = 0;             //линия
  int filter_Press = 0;
}

/* ===========================    ОБРАБОТКА ФИЛЬТРОВ     =========================== */
// Задание диапазона даты/времени

void setDTinterval(uint interval)
{
  time currentTime = getCurrentTime();
  time fromTime = currentTime - interval;

  DE_START.dateTime(fromTime);
  DE_END.dateTime(currentTime);
}

// функция определения фильтра СТАТУСА

void filterStatusCheck(){
  getValue(\"Status_RB\", \"number\", filter_Status);
}

// функция определения фильтра ТИПА

void filterTypeCheck(string dpe){
// сортировка по типу запроса продумать: возможно по классу / возможно по алиас
}

// функция определения фильтра ЛИНИИ/ПРЕССА

void filterPlaceCheck(){
// сортировка по Алиас / Дискрипшн
}

// функция определения фильтра ПРОМЕЖУТКА ВРЕМЕНИ

void filterDTCheck(){
  timeFrom = formatTime(queryDTformat, DE_START.dateTime);
  timeTo = formatTime(queryDTformat, DE_END.dateTime);
}

// =========================    ФУНКЦИИ ОПРОСА И ЗАПИСИ    =========================

dyn_dyn_anytype queryMessages(){
  dyn_dyn_anytype result;

  filterStatusCheck(); //архив или текущие?
  //текущие
  if(filter_Status == 0){
    query = base_query + active_query;
  }
  //архив
  else if(filter_Status == 1) {
    queryColorClasses(); //загрузить цвета из общего списка классов
    filterDTCheck();     //получить заданный промежуток времени
    query = base_query + archive_query + \" TIMERANGE(\\\"\" + timeFrom + \"\\\",\\\"\" + timeTo + \"\\\",1,0)\";

  }
  //DebugN(query); //проверка запроса к бд

  dpQuery(query, result);

  return result;
}

void loadMessages(dyn_dyn_anytype result){
  //  массивы для колонок таблицы
dyn_dyn_string Count_Col,
               DPe_Col,
               Abr_Col,
               DateTime_Col,
               Place_Col,
               Press_Col,
               Status_Col,
               Text_Col,
               Class_Col,
               AknTime_Col,
               User_Col;

// массив строк ответа на sql-запрос
  dyn_anytype resultRow;

// переменные-буферы для получения данных алармов
  atime messageTime; // Используем atime вместо time (alerttime)

  string ACKUser,          // Имя пользователя, который квтитровал сообщение
         ACKTime,          // время квитирования сообщения
         deviceDescript,   // Описание устройства (возможно использовать как тип)
         deviceAlias,      // Наименование устройства (имя на русском)
         curr_dp_name;     // текущий дата поинт
  int priorAlert;          // приоритет класса (для поиска цветов алармов)
  string msgClassAbr,      // аббривиатура класса
         ClassMessageColor,// цвет аларма
         RowColorText;     // цвет текста аларма


  preloadClear();
  int rowWrite = 1;
  for (int row = 2; row <= dynlen(result); row ++)
  {
    resultRow = result[row];
    curr_dp_name = dpSubStr(resultRow[DP], DPSUB_SYS_DP); //dp текущего аларма
    if(dpExists(curr_dp_name))
    {
      deviceAlias = dpGetAlias(curr_dp_name + \".\"); //ищем алиас дп (конфиг common)
      deviceDescript = dpGetDescription(curr_dp_name + \".\"); //ищем описание дп (конфиг common)
    }
    else
    {
      deviceAlias = \"\";
      deviceDescript = \"\";
    }

    messageTime = resultRow[msgTime];
    // проверяем было ли квитирование
    ACKTime = (period(resultRow[ackTime]) == 0) ? \" - \" : (string)resultRow[ackTime];
    ACKUser = (period(resultRow[ackTime]) == 0) ? \" - \" : getUserName(resultRow[user]);

    msgClassAbr = resultRow[msgAbr];
    //если архив - грузим цвета из общего массива цветов
    if(filter_Status == 1){
      priorAlert = (int)resultRow[msgPrior];
      if(dynlen(ColorClasses_array[msgPrior]) > 1)
      {
        ClassMessageColor = ColorClasses_array[priorAlert][2];
        RowColorText = ColorClasses_array[priorAlert][1];
      }
      else
      {
        dpGet(resultRow[msgClassName] + \":_alert_class.._color_c_ack\", ClassMessageColor);
        dpGet(resultRow[msgClassName] + \":_alert_class.._fore_color_c_ack\", RowColorText);
      }
    //если текущие сообщения - берем их собственные цвета
    } else if(filter_Status == 0){
        ClassMessageColor = resultRow[backColor];
        RowColorText = resultRow[foreColor];
    }
    // заполняем массивы параметров аларма
    // добавьте ClassMessageColor, RowColorText в массив чтобы добавить элементу строки цвета
      Count_Col[rowWrite] = makeDynString(getACount(messageTime), ClassMessageColor, RowColorText);    //пока не работает, не уверен что понадобится
      DPe_Col[rowWrite] = makeDynString(getAIdentifier(messageTime), ClassMessageColor, RowColorText); //массив элементов точек данных, вызвавших алармы
      DateTime_Col[rowWrite] = makeDynString(messageTime);
      Abr_Col[rowWrite] = makeDynString(msgClassAbr, ClassMessageColor, RowColorText);
      Place_Col[rowWrite] = makeDynString(deviceDescript, ClassMessageColor, RowColorText);
      Press_Col[rowWrite] = makeDynString(deviceAlias, ClassMessageColor, RowColorText);
      Text_Col[rowWrite] = makeDynString(resultRow[msgText]);
      Status_Col[rowWrite] = makeDynString(resultRow[direction]? \"Пришел\":\"Ушел\", ClassMessageColor, RowColorText);
      AknTime_Col[rowWrite] = makeDynString(ACKTime);
      User_Col[rowWrite] = makeDynString(ACKUser);

      rowWrite++;
  }
  // вносим получанные массивы данных в строки таблицы
  AlarmTable.appendLines(dynlen(DPe_Col),
                             \"Count\",       Count_Col,
                             \"DPe\",         DPe_Col,
                             \"DateTime\",    DateTime_Col,
                             \"Class\",       Abr_Col,
                             \"Place\",        Place_Col,
                             \"Press\",       Press_Col,
                             \"MessageText\", Text_Col,
                             \"Status\",      Status_Col,
                             \"AknTime\",     AknTime_Col,
                             \"User\",        User_Col);

  AlarmTable.sort(true, \"DateTime\");
}


// В архиве алармов (ушедшие квитированные алармы) ПОЛУЧАТЬ ЦВЕТА ПО АТРИБУТАМ alert_fore_color и alert_color не получится
// они там уже не хранятся либо хранятся не корректно.
// Поэтому загружается массив с цветами всех классов алармов,
// для сообщений в архиве устанавливается цвет квитированного аларма соотвующего класса.
void queryColorClasses()
{
    const string query = \"SELECT '_alert_class.._prior',\" +     //приоритет
                         \" '_alert_class.._color_c_ack',\" +     //цвет квит
                         \" '_alert_class.._fore_color_c_ack'\" + //цвет текста квит
                         \" FROM '*' WHERE _DPT = \\\"_AlertClass\\\" SORT BY 1\"; //из всех алерт классов

  // Запрашиваю данные
  dyn_dyn_anytype result; // Массив с результатами запроса
  dpQuery(query, result); // Запрос к базе данных
  for(int i = 2; i <= result.count(); i++)
  {
    ColorClasses_array[(int)result[i][2]][2] = result[i][3];//запись массива цветов фона
    ColorClasses_array[(int)result[i][2]][1] = result[i][4];//запись массива цветов рисунка
  }
}





