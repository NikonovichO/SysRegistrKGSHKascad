LANG:10027 22 Квитировать
"main(mapping event)
{
  dyn_string dpElementsAlarm;
  shape table = getShape(\"AlarmTable\");
  int firstRowm,
      lastRow;
  if(filter_Status == 1){
    DebugN(\"Квитирование в архиве запрещено\");
    return;
  }
   dyn_string classAlarm = AlarmTable.getColumnN(2);//столбец Класс
   dyn_string dpElements = AlarmTable.getColumnN(0);//столбец DPE

   //DebugN(classAlarm);
   //DebugN(dpElements);

  //все видимые (только помещющиеся!!!) на экране алармы
   getValue(table, \"lineRangeVisible\", firstRowm, lastRow);
   //смещаем на 1ед. так как таблица начинается с 0
   firstRowm++;
   lastRow++;

   int dpeAlarm = 1;
   int dpe;
   int dpeCount = dynlen(classAlarm);

   if(lastRow > dpeCount)  lastRow = dpeCount;

   for(dpe = firstRowm; dpe <= lastRow; dpe++)
   {
        dpElementsAlarm[dpeAlarm] = dpElements[dpe];
        dpeAlarm++;
   }
   	dyn_int cmd; // Массив комманд квитирования
    dpeCount = dynlen(dpElementsAlarm);
  // Заполняю массивы
  for (dpe = 1; dpe <= dpeCount; dpe++)
  {
    dpElementsAlarm[dpe] += \"._ack\";
    cmd[dpe] = 2;
    //DebugN(dpElementsAlarm[dpe], cmd[dpe]);
  }
  dpSetWait(dpElementsAlarm, cmd);

  p_result = queryMessages(query);
  loadMessages(p_result);
}" 0
