"main()
{
  setDTinterval(24*3600); // Задаю интервал времени 7 дней
  filterTypeClear();
  setValue(\"Status_RB\", \"number\", 1);

  // Инициализирую хранилище фильтров места/устройства
  placeDeviceFilter[\"columns\"] = makeDynString();
  placeDeviceFilter[\"patterns\"] = makeDynString();

  p_result = queryMessages(query); //создать запрос по филтрам
  loadMessages(p_result); //загрузить данные
