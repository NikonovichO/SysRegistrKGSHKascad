 "main(int row, string column)
{
  // Перечень столбцов для фильтрации
  dyn_string filterColumns = makeDynString(\"Class\", \"DateTime\", \"Place\", \"Press\", \"Status\");

  if(! filterColumns.contains(column)) return; // Не выполняю скрипт на неподходящем столбце

  int filterPos;
  string pattern;

  // Если нет нужного столбца в фильтре столбцов, добавляю его
  filterPos = dynContains(placeDeviceFilter[\"columns\"], column);
  if(filterPos == 0) filterPos = dynAppend(placeDeviceFilter[\"columns\"], column);

  // Определяю значение фильтра если столбец \"Дата/время\"
  pattern = (column == \"DateTime\")
          ? formatTime(\"%d\",(time)this.cellValue)+\".\"+formatTime(\"%m\",(time)this.cellValue)+\".\"+formatTime(\"%Y\",(time)this.cellValue)+\"*\"
          : this.cellValue;


  // Задаю значение фильтра для выбранного столбца
  if (dynlen(placeDeviceFilter[\"patterns\"]) < filterPos) dynAppend(placeDeviceFilter[\"patterns\"], pattern);
  else placeDeviceFilter[\"patterns\"][filterPos] = pattern;

  // Применяю фильтр
  this.filterRows(placeDeviceFilter[\"columns\"], placeDeviceFilter[\"patterns\"], true);
}" 0

