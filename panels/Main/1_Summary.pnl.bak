"main() {
  string txt;
  string name;
  string path = \"Main\\\\Summary_sub\\\\\";

  // Получаем выбранное значение из комбобокса
  getValue(\"\", \"text\", txt);

  // Полное имя точки
  switch(txt){
  case \"1\":
    path += \"Branch_1.pnl\";
    name = \"Branch1\";
    break;

  case \"2\":
    path += \"Branch_2.pnl\";
    name = \"Branch2\";
    break;
  }

  RootPanelOnModule(path, name, \"LineModule\", \"\");
}
