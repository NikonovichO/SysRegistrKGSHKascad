LANG:10027 35 Сформировать отчет
"#uses \"CtrlADO\"
main(mapping event)
{

  idispatch objXL;
  idispatch objXLWorkbooks;
  idispatch objXLWorkbook;
  idispatch objXLWorksheet;
  idispatch objRange;
  string filePath;
  string sheetName = \"Лист1\";
  filePath = \"D:\\\\Kaskad\\\\Projects\\\\SimatekSysRegistrationNew\\\\source\\\\PassportsReport.xlsx\";
  objXL = createComObject(\"Excel.Application\");


  string   cmdStr, sn, raw, model, recipe, quality, num_diaphr, cycle_counter, all_cycles, line, press;
  time  time_start,  time_end, time_forming;
  string startStr, endStr;
  bool bad_quality;
  int rc;

   rc = dbOpenConnection(conStr, conn);
  Debug(\"подключение:\", rc);

  if (!rc)
  {
    bool isPeriodChecked;
    getValue(\"chbPeriod\", \"state\", 0, isPeriodChecked);
    getValue(\"DE_START\", \"dateTime\",time_start);
    getValue(\"DE_END\", \"dateTime\", time_end);

    startStr = formatTime(\"%Y-%m-%d %H:%M:%S\", time_start);
    endStr   = formatTime(\"%Y-%m-%d %H:%M:%S\", time_end);

    cmdStr = \"SELECT serial_num, raw_tire_num, model_tire, id_recipe, bad_quality, CAST(time_start AS datetime) AS time_start, CAST(time_stop AS datetime) AS time_stop, press_fullNum, num_diaphr, count_diaphr, limit_diaphr,\"+
              +\" CAST(time_form_start AS datetime) AS time_form_start FROM vPassport\";

     if (isPeriodChecked) //выборка данных в recordset по дате
   {
     cmdStr =  cmdStr + \" WHERE time_start BETWEEN '\"+startStr+\"' AND '\"+ endStr+\"'\";
    }
    bool isPressChecked;
    getValue(\"chbPress\", \"state\", 0, isPressChecked);

  //выборка по прессу
   if(isPressChecked && !isPeriodChecked)
   {
     getValue(\"cbLine\", \"selectedText\", line);
     getValue(\"cbPress\", \"selectedText\", press);
     cmdStr = cmdStr  + \" WHERE press_fullNum = \" + line + press;
   }

    //выборка по прессу и периоду
    if(isPressChecked && isPeriodChecked)
   {
     getValue(\"cbLine\", \"selectedText\", line);
     getValue(\"cbPress\", \"selectedText\", press);
     cmdStr = cmdStr + \" AND press_fullNum = \" + line + press;
   }

  //Выборка по  серийному номеру без учета даты
    bool isSNChecked;
    getValue(\"chBox_SN\", \"state\", 0, isSNChecked);
  //  Debug(\"isSNChecked:\", isSNChecked);

  if(isSNChecked && !isPeriodChecked)
   {
     cmdStr = cmdStr + \" WHERE serial_num like '%\" +tfSerialNum.text+\"%'\";
    }

  //с дефектом
    bool isQuality;
    getValue(\"chBox_quality\", \"state\", 0, isQuality);
    if(isQuality && !isPeriodChecked)
    {
     cmdStr = \"WHERE bad_quality  = true\";;
    }

    //с дефектом за период
    if(isQuality && isPeriodChecked)
    {
     cmdStr = cmdStr + \"AND bad_quality  = true\";;
    }
    rc = dbOpenRecordset(conn, cmdStr, rs);

    Debug(\"rs:\", rc);
    Debug(\"cmdStr:\", cmdStr);


  objXL.Visible = 0; // -1 делает Excel видимым, 0 - невидимым (для фоновой работы)
  objXLWorkbooks = objXL.Workbooks;

  // Открываем СУЩЕСТВУЮЩИЙ файл
  objXLWorkbook = objXLWorkbooks.Open(filePath);
 DebugN(\"Документ открыт\");
 string sheetName = \"Sheet1\";
 objXLWorksheet = objXLWorkbook.Worksheets(sheetName);  // Первый лист (индексация с 1)

 int nstr=2;
 while (!dbEOF(rs))
    {
   DebugN(\"запись данных\");
       dbGetField(rs, 0, sn);
       dbGetField(rs, 1, raw);
       dbGetField(rs, 2, model);
       dbGetField(rs, 3, recipe);
       dbGetField(rs, 4, bad_quality);
       dbGetField(rs, 5, time_start);
       dbGetField(rs, 6, time_end);
       dbGetField(rs, 7, press);
       dbGetField(rs, 8, num_diaphr);
       dbGetField(rs, 9, cycle_counter);
       dbGetField(rs, 10, all_cycles);
       dbGetField(rs, 11, time_forming);

       objRange = objXL.Range(\"A\" + nstr);
       objRange.Value2 = sn;
       objRange = objXL.Range(\"B\" + nstr);
       objRange.Value2 = raw;
       objRange = objXL.Range(\"C\" + nstr);
       objRange.Value2 = model;
       objRange = objXL.Range(\"D\" + nstr);
       objRange.Value2 = recipe;
       objRange = objXL.Range(\"E\" + nstr);
       if (bad_quality)
       {
         objRange.Value2 = \"оклонение\";
       }
       else
       {
        objRange.Value2 = \"норма\";
       }
       objRange = objXL.Range(\"F\" + nstr);
       objRange.Value2 = formatTime(\"%Y-%m-%d %H:%M:%S\", time_forming);
       objRange = objXL.Range(\"G\" + nstr);
       objRange.Value2 = formatTime(\"%Y-%m-%d %H:%M:%S\", time_start);
       objRange = objXL.Range(\"H\" + nstr);
       objRange.Value2 = formatTime(\"%Y-%m-%d %H:%M:%S\", time_end);
       objRange = objXL.Range(\"I\" + nstr);
       objRange.Value2 = press;
       objRange = objXL.Range(\"J\" + nstr);
       objRange.Value2 = num_diaphr;
       objRange = objXL.Range(\"K\" + nstr);
       objRange.Value2 = cycle_counter;
        objRange = objXL.Range(\"L\" + nstr);
       objRange.Value2 = all_cycles;



       dbMoveNext(rs);
       nstr++;
     }
  dbCloseRecordset(rs);
  objXL.Visible = -1;
  dbCloseConnection(conn); // Соединение закрыто
}

  // Сохраняем изменения и закрываем файл
 // objXLWorkbook.Save(); // Сохраняем изменения в файле
  // objXLWorkbook.SaveAs(\"C:\\\\path\\\\to\\\\your\\\\newfile.xlsx\");  // Альтернатива: Сохранить как новый файл, не перезаписывая исходный.

 // objXLWorkbook.Close();    // Закрываем книгу

 // objXL.Quit();  // Закрываем Excel.  Это важно!
DebugN(\"Документ закрыт, проверьте результат\");
  // Освобождаем COM-объекты
 // releaseComObject(objXLWorksheet);
 // releaseComObject(objXLWorkbook);
 // releaseComObject(objXLWorkbooks);
//  releaseComObject(objXL);
}" 0
