LANG:10027 32 Применить фильтр

"#uses \"CtrlADO\"
main(mapping event)
{
  int rc;

  //массивы для хранения данных для записи в таблицу
  dyn_string arr_sn, arr_raw, arr_model, arr_recipe, arr_quality, arr_press, arr_num_diaphr, arr_cycle_counter, arr_all_cycles;
  dyn_time   arr_time_forming, arr_time_start, arr_time_end;

  string cmdStr,
         line,
         snTxt,
         press;

  string  sn,
          raw,
          model,
          recipe,
          quality,
          num_diaphr,
          cycle_counter,
          all_cycles;


  time  time_start,  time_end, time_forming;
  string startStr, endStr, quality_str;
  bool bad_quality;

  // Переменные для динамического SQL
  dyn_string whereClauses;
  string whereStr = \"\";

  tblPassports.deleteAllLines();

  //подключение к БД через ODBC. В приложении \"Администратор ODBC\" создается источник данных, в нашем случае KGSHVulcanisation
  rc = dbOpenConnection(conStr, conn);
  Debug(\"подключение:\", rc);
  this.enabled(false);
  setValue(\"L_Load\",\"visible\",true);
  if (rc != 0)
  {
    DebugTN(\"Ошибка подключения к БД\");
    return;
  }

  /* ========================= УСЛОВИЯ =========================*/

  // ---------Фильтр по времени:---------
  bool isPeriodChecked;
  getValue(\"chbPeriod\", \"state\", 0, isPeriodChecked);
  if (isPeriodChecked)
  {
    getValue(\"DE_START\", \"dateTime\", time_start);
    getValue(\"DE_END\", \"dateTime\", time_end);

    startStr = formatTime(\"%Y-%m-%d %H:%M:%S\", time_start);
    endStr   = formatTime(\"%Y-%m-%d %H:%M:%S\", time_end);

    dynAppend(whereClauses, \"time_start BETWEEN '\" + startStr + \"' AND '\" + endStr + \"'\");
  }

  // ---------Фильтр по прессу:---------
  bool isPressChecked;
  getValue(\"chbPress\", \"state\", 0, isPressChecked);
  if(isPressChecked)
  {
    getValue(\"cbLine\", \"selectedText\", line);
    getValue(\"cbPress\", \"selectedText\", press);
    dynAppend(whereClauses, \"press_fullNum = '\" + line + press + \"'\");
  }

  // ---------Фильтр по Серийному номеру---------
  bool isSNChecked;
  getValue(\"chBox_SN\", \"state\", 0, isSNChecked);
  if(isSNChecked)
  {
    getValue(\"tfSerialNum\", \"text\", snTxt);
    strreplace(snTxt, \"'\", \"''\");
    dynAppend(whereClauses, \"serial_num LIKE '%\" + snTxt + \"%'\");
  }

  // ---------Фильтр по качеству---------
  bool isQuality;
  getValue(\"chBox_quality\", \"state\", 0, isQuality);
  if (isQuality)
  {
    dynAppend(whereClauses, \"bad_quality = 1\");
  }

  /* ========================= СБОР SQL ЗАПРОСА =========================*/


    cmdStr = \"SELECT serial_num, \" +
              \"raw_tire_num, \" +
              \"model_tire, \" +
              \"id_recipe, \" +
              \"bad_quality, \" +
              \"CAST(time_start AS datetime) AS time_start, \" +
              \"CAST(time_stop AS datetime) AS time_stop, \" +
              \"press_fullNum, \" +
              \"num_diaphr, \" +
              \"count_diaphr, \" +
              \"limit_diaphr, \" +
              \"CAST(time_form_start AS datetime) AS time_form_start \" +
              \"FROM vPassport\";

   // если есть хотя бы одно условие
  if (dynlen(whereClauses) > 0)
  {
    string whereStr = \"\";

    // Обходим массив и склеиваем условия через \" AND \"
    for (int i = 1; i <= dynlen(whereClauses); i++)
    {
      if (i == 1)
      {
        whereStr += \" WHERE \" + whereClauses[i];
      }
      else
      {
        whereStr += \" AND \" + whereClauses[i];
      }
    }

    cmdStr += whereStr;
  }

    DebugTN(\"Запрос SQL:\", cmdStr);

    /* ========================= ПОЛУЧЕНИЕ ДАННЫХ =========================*/

    rc = dbOpenRecordset(conn, cmdStr, rs);
    if (rc == 0)
    {
      while (!rc && !dbEOF(rs))
      {
        dbGetField(rs, 0, sn);
        dbGetField(rs, 1, raw);
        dbGetField(rs, 2, model);
        dbGetField(rs, 3, recipe);
        dbGetField(rs, 4, bad_quality);
        dbGetField(rs, 5, time_start);
        dbGetField(rs, 6, time_end);
        dbGetField(rs, 7, press);
        dbGetField(rs, 8, num_diaphr);
        dbGetField(rs, 9, cycle_counter);
        dbGetField(rs, 10, all_cycles);
        dbGetField(rs, 11, time_forming);

        quality_str = (bad_quality) ? \"отклонение\" : \"норма\";

        dynAppend(arr_sn, sn);
        dynAppend(arr_raw, raw);
        dynAppend(arr_model, model);
        dynAppend(arr_recipe, recipe);
        dynAppend(arr_quality, quality_str);
        dynAppend(arr_time_forming, time_forming);
        dynAppend(arr_time_start, time_start);
        dynAppend(arr_time_end, time_end);
        dynAppend(arr_press, press);
        dynAppend(arr_num_diaphr, num_diaphr);
        dynAppend(arr_cycle_counter, cycle_counter);
        dynAppend(arr_all_cycles, all_cycles);

       rc = dbMoveNext(rs);
      }
      dbCloseRecordset(rs);

      if (dynlen(arr_sn) > 0)
      {
        tblPassports.appendLines(dynlen(arr_sn),
                                \"serial_num\", arr_sn,
                                \"raw\", arr_raw,
                                \"model\", arr_model,
                                \"recipe\", arr_recipe,
                                \"quality\", arr_quality,
                                \"time_forming\", arr_time_forming,
                                \"time_start\", arr_time_start,
                                \"time_end\", arr_time_end,
                                \"press\", arr_press,
                                \"num_diaphr\", arr_num_diaphr,
                                \"cycle_counter\", arr_cycle_counter,
                                \"all_cycles\", arr_all_cycles
                                );
      }
    } else {
      DebugTN(\"Ошибка выполнения запроса к БД, код:\", rc);
    }

     dbCloseConnection(conn); // Соединение закрыто
     setValue(\"L_Load\",\"visible\",false);
     this.enabled(true);

    //переводим таблицу в режим выделения записи
    tblPassports.tableMode(TABLE_SELECT_BROWSE);
    setValue (\"tblPassports\", \"selectByClick\", 1);
}" 0
