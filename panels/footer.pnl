""0  1
E "const string query = \"SELECT ALERT '_alert_hdl.._act_state'\"+           // 3
                                   \",'_alert_hdl.._ack_state'\"+         // 4
                                   \",'_alert_hdl.._abbr'\"+              // 5
                                   \",'_alert_hdl.._text'\"+              // 6
                                   \",'_alert_hdl.._direction'\"+         // 7
                                   \",'_alert_hdl.._ack_time'\"+          // 8
                                   \",'_alert_hdl.._ack_user'\"+          // 9
                                   \",'_alert_hdl.._alert_color'\"+       // 10
                                   \",'_alert_hdl.._prior'\"+             // 11
                                   \",'_alert_hdl.._alert_fore_color'\" + //12
                                   \" FROM '*'\"+
                                   \" WHERE '_alert_hdl.._prior' > 25\";

// на работу с результатом запроса
 const int DP = 1,
           msgTime = 2,
           actState = 3,
           ackState = 4,
           mClass = 5,
           text = 6,
           direction = 7,
           ackTime = 8,
           user = 9,
           backColor = 10,
           foreColor = 12;

 // команда обновить
 const int update_cmd = 10;

 // команда удалить
 const int delete_cmd = 20;

 // на массив обновления
 const int numRow_upd = 1,
           DP_upd = 2,
           msgTime_upd = 3,
           actState_upd = 4,
           ackState_upd = 5,
           mClass_upd = 6,
           text_upd = 7,
           direction_upd = 8,
           ackTime_upd = 9,
           user_upd = 10,
           backColor_upd = 11,
           foreColor_upd = 12;

 // на массив удаления
  const int numRow_del = 1,
            DP_del = 2,
            msgTime_del = 3;

const string queryDTformat = \"%d.%m.%Y %H:%M:%S\"; // Формат даты/времени для запроса

/* =================================== ОБНОВЛЕНИЕ ПОЛЯ СООБЩЕНИЙ =================================== */

OnlineLoadMessages(){
  //подписка на группу алармов по маске запроса, автоматически вносит в подписку новые подходящие точки
  dpQueryConnectSingle(\"workWithMessage\", true, 0, query);
}

workWithMessage(anytype userData, dyn_dyn_anytype result)
{
  // ------------  SUMMARY VARS  ------------

  //Определяю имена столбцов в массиве сообщений
  dyn_anytype resultRow; // Строка из массива результата
  int row;               // Номер строки для перебора

  mapping template;      // Шаблон поиска строки ссобщения

  dyn_int searchResult,  // Результат поиска строки сообщения
          deletedRows;   // Массив строк для удаления

  string ACKUser,        // Имя пользователя, который квтитровал сообщение
         ACKTime,
         medium,         // Наименование среды
         RowColorText;   // Цвет текста?

  int currNumbRow;
  time currTimeMsg;

  dyn_dyn_anytype DateTimeColl,
                  DPeColl,
                  CountColl,
                  PlaceColl,
                  deviceAliasColl,
                  deviceDescriptColl,
                  ClassColl,
                  messageTextColl,
                  Value_1Coll,
                  ACKtimeColl,
                  userColl,
                  CommentColl;

  // ------------  UPD/DEL FUNC VARS  ------------

  // массивы для записи номеров строк для обновления или удаления
  dyn_dyn_anytype updRows,
                  delRows;

  // флаги нахождений совпадений в массивах updRows, delRows
  bool found_updRows,
       found_delRows;

  // флаги проверки актуальности данных в массивах updRows, delRows
  bool actData_updRows,
       actData_delRows;

  int len_updRows,
      len_delRows;

  uint i_updRows,
       i_delRows,
       i_write;

  // Команда управления строками
  int command;

  int rowWrite;

  rowWrite = 0;

  // Показываю результат запроса
  for (row = 2; row <= dynlen(result); row ++)
  {
    resultRow = result[row];

    // Ищу строку в таблице и параметрами пришедшего сообщения
    template[\"DPe\"] = makeDynString(getAIdentifier(resultRow[msgTime])); // получаем дпе новой точки
    getValue(\"messageList\", \"lineNumbers\", template, searchResult); // по этому же идентификатору в таблице сообщений получаем массив id подходящих строк

    ACKTime = (period(resultRow[ackTime]) == 0) ? \" - \" : formatTime(queryDTformat, resultRow[ackTime]);
    ACKUser = (period(resultRow[ackTime]) == 0) ? \" - \" : getUserName(resultRow[user]);

    if (searchResult[1] == -1) // нет подходящих по шаблону строк
    { // Строки нет
      if(resultRow[actState] != DPATTR_ALERTSTATE_NONE){
        this.appendLine(\"DateTime\",       makeDynAnytype(resultRow[msgTime], resultRow[backColor], resultRow[foreColor]),
                        \"DPe\",            getAIdentifier(resultRow[msgTime]),
                        \"Count\",          getACount(resultRow[msgTime]),
                        \"Press\",          makeDynAnytype(dpGetAlias(dpSubStr(resultRow[DP], DPSUB_SYS_DP) + \".\"), resultRow[backColor], resultRow[foreColor]),
                        \"Place\",          makeDynAnytype(dpGetDescription(dpSubStr(resultRow[DP], DPSUB_SYS_DP) + \".\"), resultRow[backColor], resultRow[foreColor]),
                        \"Class\",          makeDynAnytype(resultRow[mClass], resultRow[backColor], resultRow[foreColor]),
                        \"messageText\",    makeDynAnytype(resultRow[text], resultRow[backColor], resultRow[foreColor]),
                        \"Status\",         makeDynString(resultRow[direction]? \"Пришло\":\"Ушло\", resultRow[backColor], resultRow[foreColor]),
                        \"ACKtime\",        makeDynAnytype(ACKTime, resultRow[backColor], resultRow[foreColor]),
                        \"user\",           makeDynAnytype(ACKUser, resultRow[backColor], resultRow[foreColor]));
       }
    }

    else if (resultRow[msgTime] >= this.cellValueRC(searchResult[1], \"DateTime\"))
    {
        // Сообщение новое
        // Определяю операцию
        switch(resultRow[actState])
        {
          case DPATTR_ALERTSTATE_NONE:
            command = delete_cmd;
            break;
          case DPATTR_ALERTSTATE_APP_NOT_ACK:
              command = update_cmd;
            break;
          case DPATTR_ALERTSTATE_DISAPP_NOT_ACK:
            switch(resultRow[ackState])
            {
              case DPATTR_ACKTYPE_NOT:
                command = update_cmd;
                break;
              case DPATTR_ACKTYPE_SINGLE:
                command = delete_cmd;
                break;
            }
            break;
        }

        currNumbRow = searchResult[1];    // получаем id строки в таблице
        currTimeMsg = resultRow[msgTime]; // новое время полученное из запроса

        len_updRows = dynlen(updRows);
        len_delRows = dynlen(delRows);

        found_updRows = false;
        found_delRows = false;

        actData_updRows = false;
        actData_delRows  = false;

        // если массив для удал. строк не пустой
        if(len_delRows > 0)
        {
          for(i_delRows = 1; i_delRows <= len_delRows; i_delRows++)
          {
            if(currNumbRow == delRows[i_delRows][numRow_del]) //ищем совпадение (была ли раньше отмечана текущ. строка)
            {
              found_delRows = true;

              if(delRows[i_delRows][msgTime_del] >= currTimeMsg) //сравниваем метки времени (проверяем актуальны ли данные в массиве (для удал. строк))
              {
                actData_delRows = true;
              }
              break;
            }
          }
        }

        //если массив для обнов. строк не пустой
        if(len_updRows > 0)
        {
          for(i_updRows = 1; i_updRows <= len_updRows; i_updRows++)
          {
            if(currNumbRow == updRows[i_updRows][numRow_upd]) //ищем совпадение (была ли раньше отмечана текущ. строка)
            {
              found_updRows = true;

              if(updRows[i_updRows][msgTime_upd] >= currTimeMsg) //сравниваем метки времени (проверяем актуальны ли данные в массиве (для обнов. строк))
              {
                actData_updRows = true;
              }
              break;
            }
          }
        }

        //если нашли в массиве delRows | и | данные в массиве delRows не актуальные | и |  не нашли в массиве updRows
        if(found_delRows && !actData_delRows && !found_updRows)
        {
            if(command == update_cmd) //если команда обнов. строку
            {
              delRows[i_delRows][numRow_del] = -1; //помечаем что строка на удал. не действительна

              i_write = len_updRows + 1;

              ////записываем новую строку на обновление
              updRows[i_write][numRow_upd] = currNumbRow; // новый номер строки на обновл.
              updRows[i_write][DP_upd] = resultRow[DP];
              updRows[i_write][msgTime_upd] = resultRow[msgTime];
              updRows[i_write][actState_upd] = resultRow[actState];
              updRows[i_write][ackState_upd] = resultRow[ackState];
              updRows[i_write][mClass_upd] = resultRow[mClass];
              updRows[i_write][text_upd] = resultRow[text];
              updRows[i_write][direction_upd] = resultRow[direction];
              updRows[i_write][ackTime_upd] = ACKTime;
              updRows[i_write][user_upd] = ACKUser;
              updRows[i_write][backColor_upd] = resultRow[backColor];
              updRows[i_write][foreColor_upd] = resultRow[foreColor];
            }
        }

        //если нашли в массиве updRows | и | данные в массиве updRows не актуальные | и | не нашли в массиве delRows
        else if(found_updRows && !actData_updRows && !found_delRows)         {
            //если команда обнов. строку
            if(command == update_cmd)
            {
             ////перезаписываем строку на обновление
              updRows[i_updRows][numRow_upd] = currNumbRow;//номер строки на обновл.
              updRows[i_updRows][DP_upd] = resultRow[DP];
              updRows[i_updRows][msgTime_upd] = resultRow[msgTime];
              updRows[i_updRows][actState_upd] = resultRow[actState];
              updRows[i_updRows][ackState_upd] = resultRow[ackState];
              updRows[i_updRows][mClass_upd] = resultRow[mClass];
              updRows[i_updRows][text_upd] = resultRow[text];
              updRows[i_updRows][direction_upd] = resultRow[direction];
              updRows[i_updRows][ackTime_upd] = ACKTime;
              updRows[i_updRows][user_upd] = ACKUser;
              updRows[i_updRows][backColor_upd] = resultRow[backColor];
              updRows[i_updRows][foreColor_upd] = resultRow[foreColor];
            }
            //если команда удал. строку
            else if(command == delete_cmd)
            {
              updRows[i_updRows][numRow_upd] = -1; //помечаем что строка на обновл. не действительна

              i_write = len_delRows + 1;

              delRows[i_write][numRow_del] = currNumbRow; //записываем новый номер строки на удал.
              delRows[i_write][DP_del] = resultRow[DP];
              delRows[i_write][msgTime_del] = currTimeMsg; //записываем тек. метку времени
            }
        }

        //если не нашли в массиве delRows и не нашли в массиве updRows
        else if(!found_delRows && !found_updRows)
        {
          //если команда обнов. строку
          if(command == update_cmd)
          {
              i_write = len_updRows + 1;

              ////записываем новую строку на обновление
              updRows[i_write][numRow_upd] = currNumbRow;// новый номер строки на обновл.
              updRows[i_write][DP_upd] = resultRow[DP];
              updRows[i_write][msgTime_upd] = resultRow[msgTime];
              updRows[i_write][actState_upd] = resultRow[actState];
              updRows[i_write][ackState_upd] = resultRow[ackState];
              updRows[i_write][mClass_upd] = resultRow[mClass];
              updRows[i_write][text_upd] = resultRow[text];
              updRows[i_write][direction_upd] = resultRow[direction];
              updRows[i_write][ackTime_upd] = ACKTime;
              updRows[i_write][user_upd] = ACKUser;
              updRows[i_write][backColor_upd] = resultRow[backColor];
              updRows[i_write][foreColor_upd] = resultRow[foreColor];

          }
          // если команда удал. строку
          else if(command == delete_cmd)
          {
              i_write = len_delRows + 1;

              delRows[i_write][numRow_del] = currNumbRow;                    // записываем новый номер строки на удал.
              delRows[i_write][DP_del] = getAIdentifier(resultRow[msgTime]); // resultRow[DP];
              delRows[i_write][msgTime_del] = currTimeMsg;                   // записываем тек. метку времени
          }


        }
    }
  }

// ----------------------------- ОБНОВЛЕНИЕ -----------------------------

  len_updRows = dynlen(updRows);
  len_delRows = dynlen(delRows);

  //если есть строки на обновление
  if(len_updRows > 0)
  {
    for(i_updRows = 1; i_updRows <= len_updRows; i_updRows++)
    {
            this.cellValueRC(updRows[i_updRows][numRow_upd], \"DateTime\",    makeDynAnytype(updRows[i_updRows][msgTime_upd], updRows[i_updRows][backColor_upd], updRows[i_updRows][foreColor_upd]));
            this.cellValueRC(updRows[i_updRows][numRow_upd], \"Class\",       makeDynAnytype(updRows[i_updRows][mClass_upd], updRows[i_updRows][backColor_upd], updRows[i_updRows][foreColor_upd]));

            this.cellValueRC(updRows[i_updRows][numRow_upd], \"Press\",       makeDynAnytype(dpGetAlias(dpSubStr(updRows[i_updRows][DP_upd], DPSUB_DP) + \".\"), updRows[i_updRows][backColor_upd], updRows[i_updRows][foreColor_upd]));
            this.cellValueRC(updRows[i_updRows][numRow_upd], \"Place\",       makeDynAnytype(dpGetDescription(dpSubStr(updRows[i_updRows][DP_upd], DPSUB_DP) + \".\"), updRows[i_updRows][backColor_upd], updRows[i_updRows][foreColor_upd]));

            this.cellValueRC(updRows[i_updRows][numRow_upd], \"messageText\", makeDynAnytype(updRows[i_updRows][text_upd], updRows[i_updRows][backColor_upd], updRows[i_updRows][foreColor_upd]));
            this.cellValueRC(updRows[i_updRows][numRow_upd], \"Status\",      makeDynString(updRows[i_updRows][direction_upd]? \"Пришло\":\"Ушло\", updRows[i_updRows][backColor_upd], updRows[i_updRows][foreColor_upd]));
            this.cellValueRC(updRows[i_updRows][numRow_upd], \"ACKtime\",     makeDynAnytype(updRows[i_updRows][ackTime_upd], updRows[i_updRows][backColor_upd], updRows[i_updRows][foreColor_upd]));
            this.cellValueRC(updRows[i_updRows][numRow_upd], \"user\",        makeDynAnytype(updRows[i_updRows][user_upd], updRows[i_updRows][backColor_upd], updRows[i_updRows][foreColor_upd]));
    }
  }

  // если есть строки на удаление
  if(len_delRows > 0)
  {
    for(i_delRows = 1; i_delRows <= len_delRows; i_delRows++)
    {
       this.deleteLine(1, \"DPe\", delRows[i_delRows][DP_del]);
    }
  }
}

